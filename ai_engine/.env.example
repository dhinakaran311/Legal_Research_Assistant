# ──────────────────────────────────────────────────────────────────
# Indian Legal Research Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────

# ── API ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
LOG_LEVEL=INFO
# Internal API Key for service-to-service communication
INTERNAL_API_KEY=some_internal_key

# ── LLM Provider ──────────────────────────────────────────────────
# Options: groq | ollama | gemini | openai | none
LLM_PROVIDER=groq

# ── Groq (recommended — fast, free tier) ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Fast model for classification tasks
GROQ_FAST_MODEL=llama-3.1-8b-instant

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Conversation settings ──────────────────────────────────────────
MAX_HISTORY_TURNS=10
REDIS_URL=redis://localhost:6379

# HuggingFace (if using transformer models)
HUGGINGFACE_API_KEY=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

# ── ChromaDB ───────────────────────────────────────────────────────
CHROMA_DB_PATH=./data/chromadb
CHROMA_COLLECTION_NAME=legal_documents

# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://6db506f2.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=zvhdxV75jqge_cm992yU7uRqiCFQsmZtuA51r59xMmw

# ── Postgres (Metadata) ───────────────────────────────────────────
POSTGRES_URL=postgresql://postgres:Dhina%40311@postgres:5432/lsa_db

# ── Pinecone (Optional) ───────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=legal-documents
PINECONE_NAMESPACE=legal_documents

# ── Pipeline thresholds ────────────────────────────────────────────
QUALITY_THRESHOLD=0.40
MIN_DOCS_THRESHOLD=2
